{
  "name": "opposites-champions",
  "version": "1.0.0",
  "private": true,
  "description": "אלופי ההפכים – משחק לימודי אינטראקטיבי למילים מנוגדות בעברית",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @oc/e2e test",
    "db:migrate": "pnpm --filter @oc/server prisma:migrate",
    "db:seed": "pnpm --filter @oc/server prisma:seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
