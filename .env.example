# ===== אלופי ההפכים – משתני סביבה =====
NODE_ENV=development

# כתובות ציבוריות (אין לקבע דומיין בקוד)
APP_URL=http://localhost:5173
API_URL=http://localhost:3000/api
# דומיין הפריסה (ל־Nginx / Let's Encrypt)
DOMAIN=opposites.example.com
LETSENCRYPT_EMAIL=admin@example.com

# מסד נתונים
POSTGRES_USER=opposites
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=opposites
DATABASE_URL=postgresql://opposites:change-me-strong-password@localhost:5432/opposites?schema=public

# סודות (יש להחליף! לפחות 32 תווים אקראיים)
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
COOKIE_SECRET=change-me-cookie-secret-at-least-32-chars

# מורה ראשונית (נוצרת ב־seed אם לא קיימת)
TEACHER_INITIAL_EMAIL=teacher@example.com
TEACHER_INITIAL_PASSWORD=change-me-teacher-password
TEACHER_INITIAL_NAME=המורה

# שרת
PORT=3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
